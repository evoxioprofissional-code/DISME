# DisMe — variáveis de ambiente (copie para .env.local e preencha)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: somente para o teste local scripts/security-smoke.mjs.
# Nunca exponha no cliente nem configure como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Token do bot do Discord. Somente servidor; nunca use NEXT_PUBLIC_ neste nome.
DISCORD_BOT_TOKEN=

# Token opcional da API NameDC para histórico público de usernames.
# Somente servidor; nunca use NEXT_PUBLIC_ neste nome.
NAMEDC_API_TOKEN=

# Chave server-only da API pública de histórico de usernames OathNet.
OATHNET_API_KEY=

# NexusPag (PIX). Somente servidor; nunca use NEXT_PUBLIC_ nestes nomes.
NEXUSPAG_API_KEY=
NEXUSPAG_WEBHOOK_SECRET=

# URL pública HTTPS do app (produção). Somente servidor; usada no webhook_url.
APP_URL=
